{
  "manifest_version": 3,
  "name": "TAU Moodle ID Autofiller",
  "version": "1.0.0",
  "description": "Auto-fill your ID and credentials on Tel Aviv University's Moodle and TAU websites. Set once and forget!",
  
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://moodle.tau.ac.il/*",
    "https://*.tau.ac.il/*",
    "https://tau.ac.il/*"
  ],
  
  "content_scripts": [
    {
      "matches": [
        "https://moodle.tau.ac.il/*",
        "https://*.tau.ac.il/*",
        "https://tau.ac.il/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "TAU Moodle ID Autofiller",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}